{
  "name": "canrun",
  "version": "0.0.0",
  "private": true,
  "description": "CanRun — LLM hardware calculator + programmatic SEO site (en + /ko/)",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @canrun/web dev",
    "build": "pnpm --filter @canrun/web build && pnpm run postbuild",
    "postbuild": "tsx scripts/postbuild.ts",
    "start": "tsx scripts/serve-out.ts",
    "serve-out": "tsx scripts/serve-out.ts",
    "typecheck": "tsc --noEmit && pnpm -r --no-bail typecheck",
    "lint": "eslint . && pnpm --filter @canrun/web lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:export": "vitest run --config vitest.export.config.ts",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "verify-engine": "vitest run packages/engine/test/verify-regression.test.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "sync-models": "tsx scripts/sync-models.ts",
    "add-model": "tsx scripts/add-model.ts",
    "new-model-alert": "tsx scripts/new-model-alert.ts"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.10"
  }
}
