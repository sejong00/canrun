{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm serve-out",
      "startServerReadyPattern": "listening on",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/gpu/rtx-4060",
        "http://127.0.0.1:4173/model/qwen3.5-9b",
        "http://127.0.0.1:4173/ko/gpu/rtx-4060",
        "http://127.0.0.1:4173/can-i-run/qwen3-14b/on/rtx-4060",
        "http://127.0.0.1:4173/ko/can-i-run/qwen3-30b-a3b-2507/on/rtx-3060-12gb"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 153600, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/can-i-run/).*$",
          "assertions": {
            "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2000, "aggregationMethod": "median-run" }]
          }
        },
        {
          "matchingUrlPattern": "/can-i-run/",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
            "document-title": ["error", { "minScore": 1 }],
            "meta-description": ["error", { "minScore": 1 }],
            "canonical": ["error", { "minScore": 1 }],
            "hreflang": ["error", { "minScore": 1 }],
            "crawlable-anchors": ["error", { "minScore": 1 }],
            "link-text": ["error", { "minScore": 1 }],
            "image-alt": ["error", { "minScore": 1 }],
            "http-status-code": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-report"
    }
  }
}
